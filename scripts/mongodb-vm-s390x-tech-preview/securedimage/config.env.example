# =============================================================================
# config.env.example — optional build configuration
# =============================================================================
# Copy to config.env and edit:   cp config.env.example config.env
# config.env is git-ignored. Values exported in the environment, or passed to
# make (e.g. `make build IMAGE_TAG=1.2.0`), take precedence over this file.
# Do not store credentials here; authenticate with `podman login` instead.
# Format: KEY=VALUE, one per line, no `export`, no shell expansion.

# Name and tag of the image that is built (tag defaults to the VERSION file).
IMAGE_NAME=mongodb-bootc
#IMAGE_TAG=1.0.0

# Container images used by the build.
BASE_IMAGE=registry.redhat.io/rhel9/rhel-bootc:9.6
BIB_IMAGE=registry.redhat.io/rhel9/bootc-image-builder:latest

# MongoDB release line. Set the two URLs only to use an internal mirror.
MONGODB_VERSION=8.0
#MONGODB_REPO_BASEURL=https://mirror.example.com/mongodb-enterprise/8.0/s390x/
#MONGODB_GPG_KEY_URL=https://mirror.example.com/mongodb/server-8.0.asc

# Where build results and logs are written (default: ./output next to this file).
#OUTPUT_DIR=/var/tmp/mongodb-bootc-output
#LOG_DIR=/var/tmp/mongodb-bootc-output/logs

# Minimum free space (GiB) required in OUTPUT_DIR.
#MIN_FREE_GIB=10

# Remove ALL stopped podman containers and unused volumes before running
# bootc-image-builder (only needed if it fails with "acquiring lock" errors).
#PRUNE_STALE=false

# Optional: publish the result with `sudo make push`.
#REGISTRY=registry.example.com
#REGISTRY_NAMESPACE=myorg
#PUSH_CONTAINERDISK=true
#PUSH_OCI=true
#PUSH_TLS_VERIFY=true
