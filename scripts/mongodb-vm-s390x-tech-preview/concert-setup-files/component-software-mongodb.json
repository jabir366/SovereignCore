          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "iscf_tls_protocol_compliance", "remarks": "rule_set_023" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "Verify TLS 1.2+ protocol is enforced on IngressController", "remarks": "rule_set_023" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "iscf_certificate_algorithm_strength", "remarks": "rule_set_024" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "Verify TLS certificate uses approved key size and signature algorithm", "remarks": "rule_set_024" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "iscf_cipher_governance_enforcement", "remarks": "rule_set_025" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "Verify only approved cipher suites are permitted on cluster ingress", "remarks": "rule_set_025" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "iscf_msp_key_access_control", "remarks": "rule_set_026" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "Verify Vault Kubernetes role exists for mongodb-kmip-role", "remarks": "rule_set_026" },
