# =============================================================================
# .gitignore — securedimage/
# =============================================================================

# Build output — qcow2 files are large binary artefacts, never commit them
output/
*.qcow2
*.raw
*.img
*.iso

# BIB working directories
osbuild-store/
osbuild-tmp/

# ContainerDisk wrap Containerfile (generated by build.sh at runtime)
Containerfile.disk

# Podman build cache leftovers
.podman/

# Editor / OS noise
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
