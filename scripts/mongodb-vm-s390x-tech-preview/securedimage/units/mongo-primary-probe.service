[Unit]
Description=MongoDB primary readiness probe HTTP server
# Start after mongod is up. cloud-final.service is intentionally NOT listed
# here — on first boot the probe is started by mongo-first-boot.sh (inside
# runcmd) before cloud-final completes, and listing it would cause systemctl
# start to hang waiting for a dependency that hasn't finished yet.
After=network.target mongod.service

[Service]
Type=simple
ExecStart=/usr/bin/python3.12 /usr/local/bin/mongo-primary-probe.py
Restart=always
RestartSec=5
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
