        "type": "Software",
        "title": "MongoDB Software",
        "description": "Automated compliance checks for MongoDB EA deployments on x86 OCP within the Sovereign Core environment - 21 controls.",
        "props": [
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_scram_sha256_enforced", "remarks": "rule_set_000" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "Only SCRAM-SHA-256 auth mechanism allowed. No MONGODB-CR or plain auth.", "remarks": "rule_set_000" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_no_anonymous_access", "remarks": "rule_set_001" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "No MongoDB users with empty password. --noauth flag must not be present.", "remarks": "rule_set_001" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_x509_replicaset_auth", "remarks": "rule_set_002" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "Replica set inter-member auth SHALL use x.509 certificates over TLS.", "remarks": "rule_set_002" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_tls_minimum_version", "remarks": "rule_set_003" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "All MongoDB connections SHALL use TLS 1.2 or higher.", "remarks": "rule_set_003" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_wiredtiger_encryption_at_rest", "remarks": "rule_set_004" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "All MongoDB data at rest SHALL be encrypted using WiredTiger.", "remarks": "rule_set_004" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_kmip_key_rotation", "remarks": "rule_set_005" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "Encryption keys SHALL be rotated within 365 days.", "remarks": "rule_set_005" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_audit_log_enabled", "remarks": "rule_set_008" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "MongoDB audit logging SHALL be enabled.", "remarks": "rule_set_008" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_admin_operations_logged", "remarks": "rule_set_009" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "All admin operations SHALL be captured in audit log.", "remarks": "rule_set_009" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_log_retention_90_days", "remarks": "rule_set_010" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "Audit logs SHALL be retained for at least 90 days.", "remarks": "rule_set_010" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_vm_lifecycle_logged", "remarks": "rule_set_011" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "OCP audit log SHALL capture VM create, delete, and start events.", "remarks": "rule_set_011" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_bindip_restricted", "remarks": "rule_set_012" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "MongoDB SHALL bind only to specific network interfaces.", "remarks": "rule_set_012" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_networkpolicy_blocks_external_access", "remarks": "rule_set_013" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "NetworkPolicy SHALL restrict ingress to port 27017 from same namespace only.", "remarks": "rule_set_013" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_no_external_egress", "remarks": "rule_set_014" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "All external egress from mongodb-vm SHALL be denied by default.", "remarks": "rule_set_014" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_least_privilege_db_roles", "remarks": "rule_set_015" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "No application user SHALL hold root or dbOwner role on all databases.", "remarks": "rule_set_015" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_no_root_role_in_production", "remarks": "rule_set_016" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "No user SHALL have root role in production MongoDB.", "remarks": "rule_set_016" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_ocp_serviceaccount_rbac", "remarks": "rule_set_017" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "MongoDB ServiceAccount SHALL have minimum required permissions.", "remarks": "rule_set_017" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_operator_access_audit", "remarks": "rule_set_018" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "All operator admin sessions SHALL be recorded.", "remarks": "rule_set_018" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_virt_launcher_nonroot", "remarks": "rule_set_019" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "virt-launcher pod SHALL run as non-root.", "remarks": "rule_set_019" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_vm_image_signed", "remarks": "rule_set_020" },
          { "name": "Rule_Description", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "MongoDB VM boot image SHALL be cryptographically signed and verified.", "remarks": "rule_set_020" },
          { "name": "Rule_Id", "ns": "https://ibm.github.io/compliance-trestle/schemas/oscal/cd", "value": "mongodb_guest_os_cis_hardened", "remarks": "rule_set_021" },
